# Backend Environment Variables

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host.neon.tech/database_name

# JWT Secret (generate a strong random string - min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long

# Environment
NODE_ENV=production

# Server Port (Render will set this automatically, but include for local testing)
PORT=5000

# CORS Origin (Vercel frontend URL)
CORS_ORIGIN=https://your-frontend.vercel.app
